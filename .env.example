# Copy to .env at the repository root. Keep DATABASE_URL in sync with the values below.
POSTGRES_DB=enterprise_agent
POSTGRES_USER=enterprise_agent
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://enterprise_agent:local_dev_password@localhost:5432/enterprise_agent
# JWTs are verified with config/auth-public.pem. Change issuer/audience with your identity provider.
AUTH_ISSUER=enterprise-agent-platform
AUTH_AUDIENCE=enterprise-agent-api
# Optional upload limit in bytes (default: 10 MiB).
MAX_UPLOAD_SIZE_BYTES=10485760
# Select the manual or LangChain document parsing and chunking implementation.
DOCUMENT_PROCESSING_BACKEND=manual
INDEX_TARGET_TOKENS=400
INDEX_MAX_TOKENS=600
INDEX_MAX_CHUNKS=1000
INDEX_EMBED_BATCH_SIZE=32
# Must remain at least 30 seconds below the lease.
INDEX_EMBEDDING_TIMEOUT_SECONDS=60
INDEX_LEASE_SECONDS=900
RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=15
# Required to start the indexing worker. Keep this secret out of Git.
OPENAI_API_KEY=
