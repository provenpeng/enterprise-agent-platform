# Copy to .env at the repository root. Keep DATABASE_URL in sync with the values below.
POSTGRES_DB=enterprise_agent
POSTGRES_USER=enterprise_agent
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://enterprise_agent:local_dev_password@localhost:5432/enterprise_agent
# Optional upload limit in bytes (default: 10 MiB).
MAX_UPLOAD_SIZE_BYTES=10485760
# Select the manual or LangChain document parsing and chunking implementation.
DOCUMENT_PROCESSING_BACKEND=manual
