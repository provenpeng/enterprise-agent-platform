# Copy to .env at the repository root. Keep DATABASE_URL in sync with the values below.
POSTGRES_DB=enterprise_agent
POSTGRES_USER=enterprise_agent
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://enterprise_agent:local_dev_password@localhost:5432/enterprise_agent
# JWTs are verified with config/auth-public.pem. Change issuer/audience with your identity provider.
AUTH_ISSUER=enterprise-agent-platform
AUTH_AUDIENCE=enterprise-agent-api
# Optional upload limit in bytes (default: 10 MiB).
MAX_UPLOAD_SIZE_BYTES=10485760
# Select the manual or LangChain document parsing and chunking implementation.
DOCUMENT_PROCESSING_BACKEND=manual
INDEX_TARGET_TOKENS=400
INDEX_MAX_TOKENS=600
INDEX_MAX_CHUNKS=1000
INDEX_EMBED_BATCH_SIZE=32
# Must remain at least 30 seconds below the lease.
INDEX_EMBEDDING_TIMEOUT_SECONDS=60
INDEX_LEASE_SECONDS=900
INDEX_MAX_ATTEMPTS=3
INDEX_POLL_INTERVAL_SECONDS=2
RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=15
# Optional OpenAI-compatible embedding endpoint. For Ollama, use its /v1 URL,
# a placeholder key, the installed embedding model, and its native dimensions.
# Vectors shorter than 1536 are zero-padded; retrieval only compares vectors
# produced by the configured model.
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=
# Optional stable logical provider identity when API/worker and host-side tools
# use different transport URLs for the same model weights and revision.
EMBEDDING_PROVIDER_ID=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_NATIVE_DIMENSIONS=1536
# Bump when the same endpoint and model name serve changed embedding weights.
EMBEDDING_REVISION=default
ANSWER_MODEL=gpt-4o-mini
ANSWER_GENERATION_TIMEOUT_SECONDS=30
DIAGNOSTIC_PLANNING_TIMEOUT_SECONDS=10
# Per-API-process admission limit for search, ask, and diagnose model work.
MODEL_MAX_INFLIGHT_REQUESTS=8
MODEL_ADMISSION_WAIT_SECONDS=0.1
# Optional OpenAI-compatible chat gateway. The chat key defaults to OPENAI_API_KEY.
# For a gateway with a reasoning-only default, enable this only if it supports
# the `thinking: {type: disabled}` request option.
CHAT_API_KEY=
CHAT_API_BASE_URL=
CHAT_DISABLE_THINKING=false
# Use json_mode for gateways that support JSON objects but reject JSON Schema.
CHAT_STRUCTURED_OUTPUT_METHOD=json_schema
# Default credential for both providers when dedicated keys are unset.
# A working embedding key is required for the indexing worker.
OPENAI_API_KEY=
